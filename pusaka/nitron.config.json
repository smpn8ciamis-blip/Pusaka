{
"name": "Pusaka Nedelcis",
  "packageId": "id.pusaka.nedelcis",
  "version": "1.0.0",
  "entry": "dist/index.html",
  "orientation": "portrait",
  "statusBar": true,
  "permissions": [
    "INTERNET",
    "ACCESS_NETWORK_STATE",
    "POST_NOTIFICATIONS"
  ],
  "icon": "./public/icon.png",
  "webview": {
    "backButton": "history",
    "clearCacheOnStart": false
  },
