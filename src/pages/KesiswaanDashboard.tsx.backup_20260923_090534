// ★ HOOK: Deteksi kelas yang BELUM mengisi absensi pada tanggal tertentu
//   Membandingkan TOTAL KELAS vs kelas yang punya absensi di tanggal itu
// =====================================================================
// =====================================================================
// ★ HOOK v4: Deteksi kelas belum mengisi absensi (STRICT YEAR FILTER)
//   - HANYA ambil kelas dengan indikator tahun pelajaran aktif
//   - Tampilkan nama ASLI (dengan suffix tahun) ke UI
//   - Wali kelas: multi-strategy + debug kolom
// =====================================================================
function detectGrade(name: string): string {
  const n = String(name).trim();
  const numMatch = n.match(/^(\d{1,2})/);
  if (numMatch) return numMatch[1];
  const romanMatch = n.match(/^(XII|XI|X|IX|VIII|VII|VI|V|IV|III|II|I)\b/i);
  if (romanMatch) return romanMatch[1].toUpperCase();
  return "Lainnya";
}

function gradeOrder(g: string): number {
  const num = parseInt(g, 10);
  if (!isNaN(num)) return num;
  const romanMap: Record<string, number> = {
    I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6,
    VII: 7, VIII: 8, IX: 9, X: 10, XI: 11, XII: 12,
  };
  return romanMap[g] ?? 999;
}

function cleanClassName(name: string): string {
  return String(name).replace(/[_\s]*\d{4}\/\d{4}\s*$/, "").trim();
}

function hasYearSuffix(name: string, year: string): boolean {
  if (!year) return false;
  const re = new RegExp(`[\\s_]*${year.replace("/", "\\/")}\\s*$`);
  return re.test(String(name));
}

function extractYearSuffix(name: string): string | null {
  const m = String(name).match(/(\d{4}\/\d{4})\s*$/);
  return m ? m[1] : null;
}

function normalizeClassName(name: string): string {
  return String(name)
    .replace(/[_\s]*\d{4}\/\d{4}\s*$/, "")
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "");
}

function useActiveClassesForYear(academicYear?: string) {
  return useQuery({
    queryKey: ["active-classes-for-year", academicYear || ""],
    queryFn: async () => {
      const dbg: string[] = [];

      // --- 1) Ambil semua kelas ---
      let allClasses: any[] = [];
      let classTable = "";
      for (const t of ["classes", "kelas", "class", "master_classes"]) {
        try {
          const { data, error } = await supabase.from(t).select("*");
          if (!error && data?.length) {
            allClasses = data;
            classTable = t;
            dbg.push(`classes[${t}]=${data.length}`);
            if (data[0]) {
              const cols = Object.keys(data[0]);
              dbg.push(`columns=[${cols.join(",")}]`);
            }
            break;
          }
        } catch { /* ignore */ }
      }

      // --- 2) Filter by academic year ---
      let filtered = allClasses;
      if (academicYear && allClasses.length) {
        const yearCols = [
          "academic_year", "school_year", "tahun_pelajaran",
          "tahun_ajaran", "year", "periode", "schoolYear",
        ];
        let yearCol: string | null = null;
        for (const col of yearCols) {
          if (allClasses.some(c => c[col] != null && String(c[col]).trim())) {
            yearCol = col; break;
          }
        }
        if (yearCol) {
          filtered = allClasses.filter(
            c => String(c[yearCol!] || "").trim() === academicYear
          );
          dbg.push(`filter[${yearCol}="${academicYear}"]: ${filtered.length}/${allClasses.length}`);
        } else {
          const re = new RegExp(`[\\s_]*${academicYear.replace("/", "\\/")}\\s*$`);
          const withSuffix = allClasses.filter(c =>
            re.test(String(c.name || c.nama || c.class_name || ""))
          );
          if (withSuffix.length > 0) {
            filtered = withSuffix;
            dbg.push(`filter[name-suffix="${academicYear}"]: ${filtered.length}/${allClasses.length}`);
          } else {
            dbg.push(`⚠ tidak ada indikator tahun — pakai semua (${allClasses.length})`);
          }
        }
      }

      // --- 3) Resolve wali kelas ---
      const teacherMap: Record<string, string> = {};

      const teacherNameCols = [
        "wali_kelas", "homeroom_teacher", "teacher_name",
        "nama_wali_kelas", "nama_wali", "guru_name", "nama_guru",
      ];
      const teacherIdCols = [
        "teacher_id", "wali_kelas_id", "homeroom_teacher_id",
        "teacherId", "guru_id", "id_guru", "wali_id",
        "homeroom_id", "id_wali_kelas",
      ];

      let teacherNameCol: string | null = null;
      let teacherIdCol: string | null = null;

      // Cek kolom nama dulu
      for (const col of teacherNameCols) {
        if (filtered.some(c => typeof c[col] === "string" && String(c[col]).trim())) {
          teacherNameCol = col;
          dbg.push(`wali.nama="${col}"`);
          break;
        }
      }
      // Cek kolom ID
      if (!teacherNameCol) {
        for (const col of teacherIdCols) {
          if (filtered.some(c => c[col] != null)) {
            teacherIdCol = col;
            dbg.push(`wali.id="${col}"`);
            break;
          }
        }
      }

      // Resolve ID → nama
      if (teacherIdCol && !teacherNameCol) {
        const ids = [
          ...new Set(filtered.map(c => c[teacherIdCol!]).filter(Boolean).map(String))
        ];
        if (ids.length) {
          const teacherTables = [
            "teachers", "users", "profiles", "guru", "pegawai", "staff", "user_profiles",
          ];
          for (const t of teacherTables) {
            try {
              const { data } = await supabase.from(t).select("*").in("id", ids);
              if (data?.length) {
                for (const row of data) {
                  const nm = row.name || row.full_name || row.nama ||
                             row.nama_lengkap || row.display_name || row.username;
                  if (nm) teacherMap[String(row.id)] = String(nm);
                }
                dbg.push(`resolved wali[${t}]=${data.length}/${ids.length}`);
                if (Object.keys(teacherMap).length > 0) break;
              }
            } catch { /* ignore */ }
          }
        }
      }

      // --- 4) Map hasil ---
      const result = filtered.map(c => {
        const raw = String(c.name || c.nama || c.class_name || c.nama_kelas || "-");
        const wali = teacherNameCol
          ? String(c[teacherNameCol] || "").trim()
          : teacherIdCol
            ? teacherMap[String(c[teacherIdCol])] || ""
            : "";
        return {
          id: c.id,
          displayName: raw,
          normalized: normalizeClassName(raw),
          grade: detectGrade(raw),
          waliKelas: wali,
        };
      }).sort((a, b) =>
        a.displayName.localeCompare(b.displayName, "id", { numeric: true })
      );

      // eslint-disable-next-line no-console
      console.log("[useActiveClassesForYear]", {
        academicYear,
        totalAll: allClasses.length,
        filtered: result.length,
        waliFound: result.filter(c => c.waliKelas).length,
        sample: result.slice(0, 5).map(c => ({
          name: c.displayName, wali: c.waliKelas || "(kosong)"
        })),
        debug: dbg,
      });

      return { classes: result, debug: dbg, totalAll: allClasses.length };
    },
    staleTime: 60_000,
  });
}

const UnfilledClassesCard = memo(function UnfilledClassesCard({
  academicYear,
  attendanceByClass,
  allClasses,
}: {
  academicYear?: string;
  attendanceByClass: any;
  allClasses: any[];
}) {
  // ==================================================================
  // Sumber kebenaran:
  //   allClasses       → dari genderStats.byClass (rekap rombel)
  //   attendanceByClass → dari useAttendanceByClass (kelas yg sudah absen)
  // ==================================================================

  const filledSet = useMemo(() => {
    const s = new Set<string>();
    const list = attendanceByClass?.filledClasses || [];
    list.forEach((c: any) => {
      const name = String(
        c?.className || c?.class_name || c?.nama_kelas ||
        c?.name || c?.kelas || c?.nama || ""
      );
      if (name) s.add(_normName(name));
    });
    return s;
  }, [attendanceByClass]);

  const unfilled = useMemo(() => {
    return (allClasses || [])
      .filter((c) => {
        const name = String(
          c?.className || c?.class_name || c?.nama_kelas ||
          c?.name || c?.kelas || c?.nama || ""
        );
        return name && !filledSet.has(_normName(name));
      })
      .map((c) => {
        const raw = String(
          c?.className || c?.class_name || c?.nama_kelas ||
          c?.name || c?.kelas || c?.nama || "-"
        );
        const wali = String(
          c?.waliKelas || c?.wali_kelas || c?.teacherName ||
          c?.teacher_name || c?.nama_wali_kelas || c?.nama_wali ||
          c?.wali || c?.homeroom_teacher || c?.homeroom_teacher_name || ""
        ).trim();
        return {
          id: raw,
          displayName: raw,
          normName: _normName(raw),
          grade: _detectGrade(raw),
          waliKelas: wali,
        };
      })
      .sort((a, b) =>
        a.displayName.localeCompare(b.displayName, "id", { numeric: true })
      );
  }, [allClasses, filledSet]);

  const total = (allClasses || []).length;
  const filled = total - unfilled.length;

  // ============ DEBUG ============
  useEffect(() => {
    // eslint-disable-next-line no-console
    console.log("[UnfilledClassesCard v8]", {
      totalAll: total,
      filled: filled,
      unfilled: unfilled.length,
      filledNormalized: [...filledSet].slice(0, 20),
      sampleAllClasses: (allClasses || []).slice(0, 3),
      sampleUnfilled: unfilled.slice(0, 3),
    });
  }, [total, filled, unfilled, filledSet, allClasses]);

  // ============ LOADING ============
  if (total === 0) {
    return (
      <Card className="border-border/60">
        <CardHeader className="pb-3">
          <SectionHeader
            icon={FileWarning}
            title="Kelas Belum Mengisi Absensi"
            description="Memuat data kelas..."
